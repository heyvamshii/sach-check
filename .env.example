# Copy this file to .env.local and fill in what you have. Every key is optional and free.
# With no keys at all the app still works in "basic mode" (rule-based steps + Google News).

# Groq (free): https://console.groq.com/keys. Powers models 1, 2 and 5
GROQ_API_KEY=your_groq_api_key_here

# Google Fact Check Tools API (free): https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_key_here

# Tavily web search (free tier): https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional Telegram bot (free): create one with @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# any long random string you make up; Telegram sends it back so we know requests are real
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# Optional: override the first-choice Groq model for a step
# GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
# GROQ_CLASSIFY_MODEL=qwen/qwen3.8-27b
# GROQ_JUDGE_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
